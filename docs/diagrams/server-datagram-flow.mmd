%% MBTA-Go 服务端路径④⑤：DATAGRAM + 流控背压下发
flowchart TD
    classDef datagram fill:#9b9b9b,stroke:#666,color:#fff
    classDef active fill:#bd10e0,stroke:#880ba3,color:#fff
    classDef flow fill:#50e3c2,stroke:#2aab8a,color:#000
    classDef goroutine fill:#f5a623,stroke:#c47c00,color:#000

    %% 路径④ DATAGRAM 不可靠通道
    subgraph P4["④ DATAGRAM 不可靠通道 at-most-once"]
        direction TB
        DLD["📥 dataLoop 收 TypeDatagram"]:::datagram
        PD["processDatagram<br/>handler_batch.go:128"]:::datagram
        OPEN2["core.Open HMAC+解密<br/>失败 → 静默丢弃"]:::datagram
        RAW2["OnRawBatch 投递<br/>无 ACK 无 Replay 无流控"]:::datagram
        DLD --> PD --> OPEN2 --> RAW2
    end

    %% 路径⑤ 流控背压下发
    subgraph P5["⑤ 流控背压下发 S→C"]
        direction TB
        SRC1["触发: batchSem 满<br/>并发超限"]:::goroutine
        SRC2["触发: window.CanSend 超限<br/>窗口满"]:::flow
        SRC3["触发: sink 返回 Throttle<br/>队列压力"]:::flow
        SRC4["触发: OnPressure 变化<br/>背压状态"]:::flow

        ST["🟢 sendThrottle<br/>handler_send.go:43"]:::active
        AP["applyPressure<br/>pressureMu 比较更新<br/>同值不下发"]:::active
        PTW["pressureToWindow 映射<br/>normal 全量 / degraded ½ / critical 1/10"]:::flow
        WU["window.Update"]:::flow
        SWU["🟢 sendWindowUpdate<br/>handler_send.go:101"]:::active

        SRC1 --> ST
        SRC2 --> ST
        SRC3 --> ST
        SRC4 --> AP --> PTW --> WU --> SWU
    end
