%% MBTA-Go 服务端路径③：processBatch 核心数据路径
%% 服务端流控用 Inflight+Window（区别于客户端 AckTracker）
flowchart TD
    classDef goroutine fill:#f5a623,stroke:#c47c00,color:#000
    classDef flow fill:#50e3c2,stroke:#2aab8a,color:#000
    classDef passive fill:#7ed321,stroke:#5da018,color:#000
    classDef active fill:#bd10e0,stroke:#880ba3,color:#fff
    classDef entry fill:#4a90d9,stroke:#2c5f9e,color:#fff

    DL["📥 dataLoop 收 TypeBatch"]:::entry
    SEM["⚙ batchSem 并发限制<br/>满 → 🟢 sendThrottle"]:::goroutine

    PB["⚙ processBatch goroutine<br/>handler_batch.go:15"]:::goroutine
    OPEN["core.Open envelope<br/>VerifyMAC hmac.Equal<br/>→ AEAD 解密 → decompress"]:::flow
    FAIL["🔵 HMAC/解密失败<br/>→ sendNack"]:::passive

    DECODE["Decode BatchMessage<br/>→ ValidateBatch<br/>→ ValidateBatchTraceContext"]
    RESOLVE["resolveBatchEvents<br/>RawEventSink 快路径 vs 完整解码"]:::flow

    SFC["服务端流控<br/>window.CanSend inflight"]:::flow
    ADD["inflight.Add"]:::flow
    THROT["🟢 CanSend 失败<br/>→ sendThrottle"]:::active

    REPLAY["ReplayCache.SeenOrAdd"]:::flow
    HIT["replay 命中<br/>inflight.Remove 回退<br/>→ 🔵 sendAck"]:::passive

    RA["routeAndACK<br/>handler_batch.go:253"]:::entry
    SINK["投递到 Sink<br/>OnRawBatch / OnSignalBatchWithResult<br/>/ OnSignalBatch + OnPressure"]:::flow
    ARR["applyRouteResult<br/>Durable → DurableACK<br/>Throttle → sendThrottle<br/>压力 → applyPressure"]
    DEF["defer inflight.Remove"]:::flow
    SACK["🔵 sendAck"]:::passive

    DL --> SEM --> PB --> OPEN
    OPEN -. 失败 .-> FAIL
    OPEN --> DECODE --> RESOLVE --> SFC
    SFC -. false .-> THROT
    SFC --> ADD --> REPLAY
    REPLAY -. 命中 .-> HIT
    REPLAY --> RA --> SINK --> ARR --> SACK
    RA -. 投递完成 .-> DEF
