---
title: "MBTA-GO 架构分层"
---
%%{init: {'theme':'default', 'themeVariables': {'background':'#ffffff', 'mainBkg':'#ffffff'}}}%%
flowchart TB
    %% ===== 用户入口层 =====
    subgraph Entry["用户入口"]
        APP["应用代码"]
    end

    %% ===== 外壳分发层 =====
    subgraph Shell["外壳层 · versionedClient 接口分发"]
        MBTA["mbta.Client<br/>根目录 client.go"]
    end

    %% ===== 薄包装层 (binding 特化) =====
    subgraph Wrappers["薄包装层 · 传输特化 Client"]
        V1C["v1.Client<br/>QUIC 多流"]
        NTLC["ntls.Client<br/>TCP / TLCP 单连接"]
    end

    %% ===== 协议核心层 (binding 无关) =====
    subgraph Core["协议核心层 · 共享"]
        CC["protocol.CoreClient<br/>状态机/握手/ACK/drain/heartbeat"]
        CH["protocol.CoreHandler<br/>服务端 controlLoop/processBatch"]
    end

    %% ===== 握手桥接层 =====
    subgraph Binding["binding 握手桥接 · 消除 v1/ntls 重复"]
        BH["binding.Handshake<br/>dial→setupTransport→postAuth→StartLifecycle"]
    end

    %% ===== 传输抽象层 =====
    subgraph Transport["传输抽象 · ClientTransport/Transport 接口"]
        V1T["v1ClientTransport<br/>controlMu + picker"]
        NTLT["ntlsClientTransport<br/>writeMu 串行写"]
    end

    %% ===== 底层网络 =====
    subgraph Net["底层传输"]
        QUIC["QUIC + TLS1.3"]
        TCP["TCP + TLCP/RFC8998"]
    end

    APP --> MBTA
    MBTA --> V1C
    MBTA --> NTLC

    V1C -->|"委托协议逻辑"| CC
    NTLC -->|"委托协议逻辑"| CC

    V1C -.->|"Connect 时调用"| BH
    NTLC -.->|"Connect 时调用"| BH
    BH -->|"编排"| CC

    V1C -->|"持有"| V1T
    NTLC -->|"持有"| NTLT
    CC -->|"ReadFrame/WriteFrame"| V1T
    CC -->|"ReadFrame/WriteFrame"| NTLT

    V1T --> QUIC
    NTLT --> TCP

    CH -->|"服务端用同接口"| V1T
    CH -->|"服务端用同接口"| NTLT

