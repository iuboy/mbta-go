%% MBTA-Go 服务端路径①②：启动 + 握手
%% 🟢=主动下发 S→C / 📥=接收 C→S
flowchart TD
    classDef entry fill:#4a90d9,stroke:#2c5f9e,color:#fff
    classDef active fill:#bd10e0,stroke:#880ba3,color:#fff
    classDef goroutine fill:#f5a623,stroke:#c47c00,color:#000
    classDef flow fill:#50e3c2,stroke:#2aab8a,color:#000

    %% 路径①启动
    subgraph P1["① 服务启动 + 接受连接"]
        direction TB
        NS["mbta.NewServer → With* 注入<br/>server.go:56"]:::entry
        START["Server.Start → errgroup 并发<br/>initV1 / initNTLS"]
        RUN["binding.Server.Run → AcceptLoop"]
        HC["handleConn<br/>defer recover 防 panic<br/>→ newTransport"]
        NCH["NewCoreHandler<br/>选 batchSem QUIC64/TCP8<br/>NewWindow + Inflight + ReplayCache"]:::flow
        HANDLE["CoreHandler.Handle<br/>→ controlLoop"]:::entry
        NS --> START --> RUN --> HC --> NCH --> HANDLE
    end

    %% 路径②握手
    subgraph P2["② 握手 HELLO/AUTH"]
        direction TB
        CL["📥 controlLoop 收 TypeHello<br/>RecvControlFrame 循环"]:::entry
        HH["handleHello<br/>ValidateHello → Negotiate<br/>setAgentID/SessionID/ChallengeNonce"]
        H0RTT["0-RTT 恢复<br/>SessionStore.Get → keys.Store"]:::flow
        SHK["🟢 SendControlFrame HELLO_ACK<br/>含 InitialWindow"]:::active

        HA2["📥 TypeAuth → handleAuth<br/>ValidateAuth + resolveAuthToken<br/>ComputeChallengeResponse HMAC 校验"]
        GENK["GenerateSessionKeys<br/>→ keys.Store + expiresAt"]:::flow
        TICKET["0-RTT ticket 颁发<br/>SessionStore.Put"]:::flow
        SAOK["🟢 SendControlFrame AUTH_OK<br/>含会话密钥 + ticket"]:::active
        READY["sm.Transition Ready<br/>→ OnSession Connected<br/>→ HA redirect 检查"]
        DLOOP["⚙ dataOnce.Do 启动 dataLoop"]:::goroutine

        CL --> HH --> H0RTT --> SHK
        CL --> HA2 --> GENK --> TICKET --> SAOK --> READY --> DLOOP
    end
