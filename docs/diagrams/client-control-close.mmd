%% MBTA-Go 客户端路径③④⑤：ACK处理 + 流控反馈 + 关闭
flowchart TD
    classDef goroutine fill:#7ed321,stroke:#5da018,color:#000
    classDef tracker fill:#50e3c2,stroke:#2aab8a,color:#000
    classDef flow fill:#bd10e0,stroke:#880ba3,color:#fff
    classDef close fill:#d0021b,stroke:#9b0014,color:#fff

    %% 路径③ ACK/NACK 处理
    subgraph P3["③ ACK/NACK 处理"]
        direction TB
        RCL["⚙ ReadControlLoop<br/>收 TypeAck"]:::goroutine
        HA["handleAck<br/>chunkIDFromWire<br/>client_control.go:78"]
        REL["tracker.Release seq+chunkID<br/>返回 slot"]:::tracker
        LAT["metrics.BatchLatency.Observe<br/>slot.SentAt"]
        DISP["dispatchACK → ackQueue"]
        WORK["⚙ runACKWorker 消费<br/>→ 用户 ACK 回调"]:::goroutine
        NDE["notifyDrainIfEmpty<br/>tracker.Empty → drainCh"]:::tracker
        RCL --> HA --> REL --> LAT --> DISP --> WORK
        HA --> NDE
    end

    %% 路径④ 流控反馈
    subgraph P4["④ 流控反馈 WINDOW/THROTTLE"]
        direction TB
        RCL2["⚙ ReadControlLoop<br/>收 TypeWindow / TypeThrottle"]:::goroutine
        HW["handleWindow<br/>→ tracker.UpdateLimits"]:::tracker
        HT["handleThrottle<br/>→ throttle.Apply 设截止时间"]:::flow
        RCL2 --> HW
        RCL2 --> HT
    end

    %% 路径⑤ 关闭
    subgraph P5["⑤ 关闭 Close 8 步"]
        direction TB
        S1["1. 发 CLOSE 帧"]:::close
        S2["2. 进入 Draining"]:::close
        S3["3. 等 drainCh / 30s 超时"]:::close
        S4["4. lifecycleCancel 取消 goroutine"]:::close
        S5["5. CloseConn 关连接"]:::close
        S6["6. waitGoroutines 等 4 个退出"]:::close
        S7["7. tracker.Reset 清空 slot"]:::tracker
        S8["8. 清零密钥 🔒 sendMu"]:::close
        S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7 --> S8
    end

    NDE -. drain 触发 .-> S3
